{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "react-figma",
  "builds": [
    {
      "src": "website/package.json",
      "use": "@vercel/static-build",
      "config": {"distDir": "build"}
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "^/(.*)",
      "dest": "/website/$1"
    }
  ]
}
